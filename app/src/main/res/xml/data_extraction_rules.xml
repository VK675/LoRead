<?xml version="1.0" encoding="utf-8"?>
<!-- Backup rules for Android 12 and newer. Book files are large and can be copied again,
     so they stay out of the cloud backup; settings and reading positions are still backed up. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="external" path="books/" />
    </cloud-backup>
</data-extraction-rules>
